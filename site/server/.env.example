# Customer-operated installation. Set these in the hosting environment.
# This file is documentation, not an automatically loaded dotenv file.
# Normal mode requires App Service Authentication on all paths. The explicitly
# enabled installer permits only setup-code-protected installation until Entra
# is verified. Easy Auth must remain enabled to strip caller-supplied headers.
GALLERY_DISTRIBUTION=customer
GALLERY_BRAND_NAME=Deployment Portal
# Raw source/ZIP hosting requires these. The container discovers them from the
# preconfigured App Service Entra provider and rejects mismatching overrides.
GALLERY_ENTRA_TENANT_ID=
GALLERY_ENTRA_CLIENT_ID=
GALLERY_EASY_AUTH=true
# Comma-separated Entra object GUIDs eligible for initial admin bootstrap.
GALLERY_ADMIN_OIDS=

# Default container flow: preconfigure Entra in App Service Authentication,
# require authentication on every path, and set GALLERY_ADMIN_OIDS above.
# No setup secret is needed. Private connectivity, managed identity/RBAC and
# persistent storage remain customer-managed hosting prerequisites.
# Only the optional GALLERY_INSTALLER_ENABLED=true mode uses this random secret;
# its digest and one-hour expiry are derived and persisted by the container.
GALLERY_SETUP_SECRET=

# First-run browser installation; disabled unless explicitly provisioned.
# Use a fresh database, HTTPS-only App Service and no existing identity provider.
# Generate a random 32-byte code locally; store only its SHA-256 digest here.
# UTC expiry must be in the future and at most 24 hours away. Sessions last at
# most 30 minutes. Completion disables installation and removes the digest.
GALLERY_INSTALLER_ENABLED=false
GALLERY_SETUP_CODE_SHA256=
GALLERY_SETUP_EXPIRES_AT=
GALLERY_PUBLIC_URL=

# Optional hosted setup automation: this exact App Service resource ID.
# The deployment identity needs Website Contributor here to configure providers.
# Entra registration creation additionally needs customer-admin-consented
# Microsoft Graph Application.ReadWrite.OwnedBy. Never grant these automatically.
GALLERY_HOST_RESOURCE_ID=

# HTTPS is required for customer installations.
GALLERY_HTTPS=true

# --------------------------------------------------------------------------- #
# Control plane: deployments, telemetry, admin
# --------------------------------------------------------------------------- #

# Use fresh customer-controlled persistent storage, never an internal database.
# One worker and one instance are required by the current scheduler/database.
GALLERY_DB_PATH=/home/data/deployment-portal.db

# Default and ceiling for deployment lifetime (hours). Guests are clamped to
# this; admins may pick any end time. Auto-cleanup deletes the resource group
# when the end time is reached.
GALLERY_MAX_LIFETIME_HOURS=48

# How often the background scheduler sweeps for due (expired) deployments.
GALLERY_CLEANUP_INTERVAL_SECONDS=300

# --------------------------------------------------------------------------- #
# Azure executor (the backend deploys directly with its managed identity)
# --------------------------------------------------------------------------- #
#
# Customer mode uses only this user-assigned managed identity. There is no
# fallback to developer/CLI credentials. Attach it to your web app.
AZURE_CLIENT_ID=
# Optional on raw source hosting; container defaults to system if no client ID.
# GALLERY_MANAGED_IDENTITY=system
#
# Least-privilege roles granted to that identity at SUBSCRIPTION scope (required
# because each deployment creates its own resource group, a subscription-level
# action):
#   * Contributor                         - create/manage/delete resources + RGs
#   * Role Based Access Control Administrator (constrained, condition v2.0)
#                                         - create the RBAC role assignments the
#                                           keyless/passwordless templates need,
#                                           while the built-in condition BLOCKS
#                                           assigning privileged roles (Owner,
#                                           Contributor, UAA, RBAC Admin) so the
#                                           deployer cannot escalate privilege.
#
# No templates are supplied. Compile your own code using your own toolchain.
# Publish runtime inputs as described in the customer README.

# Subscription deployments target (resource groups are created per deployment).
GALLERY_SUBSCRIPTION_ID=

# Tenant that owns GALLERY_SUBSCRIPTION_ID. Portal links include this tenant so
# B2B guests open the resource group in the subscription's directory.
ARM_TENANT_ID=

# Azure region for the per-deployment resource groups.
GALLERY_DEPLOY_LOCATION=eastus

# After a successful deploy, grant the signed-in user the built-in Reader role on
# their deployment's RESOURCE GROUP so they can view the resources in the Azure
# portal. The assignment is RG-scoped, so it is removed automatically when the
# group is torn down. Best-effort: a failure never fails the deployment. Reader
# is grantable under the deployer identity's constrained RBAC-Admin condition
# (which blocks Owner/Contributor/UAA/RBAC Admin). Set to false to disable.
GALLERY_GRANT_VIEW_ACCESS=false

# Automatic cross-tenant invitations are disabled for customer installations.
GALLERY_INVITE_GUEST=false

# --------------------------------------------------------------------------- #
# Terraform engine (optional second deploy engine alongside Bicep)
# --------------------------------------------------------------------------- #
# Customers author their own Bicep or Terraform workloads. To enable Terraform,
# the host needs the
# terraform CLI and the azurerm provider must authenticate as the app's managed
# identity. The deploy modal always shows the Terraform CLI snippet; the in-app
# "deploy with Terraform" option only appears when the binary is resolvable
# (see GET /api/me -> terraformExecAvailable), so leaving these unset is safe.
#
# Install and maintain Terraform yourself. Auto-download is disabled.
# GALLERY_TERRAFORM_BIN=/home/bin/terraform
GALLERY_TERRAFORM_AUTO_INSTALL=false
#
# Customer mode forces managed identity auth and the configured subscription.
# ARM_USE_MSI=true
# ARM_SUBSCRIPTION_ID=<your-subscription-guid>
#
# State: omit for local state on the persistent /home share (fine for a single
# gunicorn worker). Set these to use an azurerm remote backend instead; the MI
# then also needs "Storage Blob Data Contributor" on the state account.
# GALLERY_TF_STATE_STORAGE=<your-state-account>
# GALLERY_TF_STATE_RG=<your-state-resource-group>
# GALLERY_TF_STATE_CONTAINER=tfstate

# --------------------------------------------------------------------------- #
# Use-case submissions (zip upload -> review branch)
# --------------------------------------------------------------------------- #
# When a user uploads a template zip, the backend validates + stages it and then
# optionally creates a review BRANCH in your configured repository. A maintainer
# opens the pre-filled pull request. Without a token uploads stay staged for manual
# download from the admin panel.
#
# Legacy optional default. Prefer saving the customer OAuth App client ID in
# Setup > GitHub. Enable Device Flow in that app; no token is entered in Setup.
GALLERY_GITHUB_OAUTH_CLIENT_ID=
# Populated server-side after device authorization in the chosen host/vault store.
# The token is a secret; never commit it. Legacy host tokens are also supported.
GALLERY_GITHUB_TOKEN=
# Unix expiration timestamp set by sign-in when supplied by GitHub; 0 means no
# advertised expiry. Expired tokens require another Connect GitHub authorization.
GALLERY_GITHUB_TOKEN_EXPIRES_AT=0
# Customer-owned owner/repo. No default destination. Both repo and token must be
# supplied to enable publishing. Never configure a publisher-owned destination.
GALLERY_GITHUB_REPO=
# Base branch the review branch is cut from (defaults to main).
GALLERY_GITHUB_BASE=main

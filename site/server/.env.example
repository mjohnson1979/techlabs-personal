# Microsoft Entra tenant (directory) GUID. Restricts sign-in to your
# organization's accounts. Find it in the Azure portal:
#   Microsoft Entra ID -> Overview -> Tenant ID
#
# Leave as "organizations" to allow any work/school account (less strict),
# or "common" to also allow personal Microsoft accounts (not recommended
# for an internal tool).
GALLERY_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Set to true when the app is served over HTTPS (e.g. behind a TLS proxy).
# Enables Secure cookies + HSTS. Keep false for local http://localhost.
GALLERY_HTTPS=false

# --------------------------------------------------------------------------- #
# Control plane: deployments, telemetry, admin
# --------------------------------------------------------------------------- #

# SQLite database path. On App Service, /home is persistent (Azure Files), so
# the default survives restarts/redeploys. Local dev falls back to
# site/server/data/techlabs.db when /home is not writable.
GALLERY_DB_PATH=/home/data/techlabs.db

# Admin access is bootstrapped automatically: the FIRST person to sign in
# becomes the admin (persisted in the database). Make sure you are the first to
# log in after a fresh deploy. Admins see all data and manage roles from the
# admin panel; everyone else is a guest (own data only).

# Default and ceiling for deployment lifetime (hours). Guests are clamped to
# this; admins may pick any end time. Auto-cleanup deletes the resource group
# when the end time is reached.
GALLERY_MAX_LIFETIME_HOURS=48

# How often the background scheduler sweeps for due (expired) deployments.
GALLERY_CLEANUP_INTERVAL_SECONDS=300

# --------------------------------------------------------------------------- #
# Azure executor (the backend deploys directly with its managed identity)
# --------------------------------------------------------------------------- #
#
# The backend stores NO Azure secret. In production it authenticates with a
# DEDICATED user-assigned managed identity (id-techlabs-deployer) attached to the
# web app; locally it uses your `az login` / developer credentials. Because the
# web app may carry more than one identity, set AZURE_CLIENT_ID to the deployer
# identity's client ID so DefaultAzureCredential selects it.
AZURE_CLIENT_ID=0159c318-e7f6-4443-87c2-27b47c22a61c
#
# Least-privilege roles granted to that identity at SUBSCRIPTION scope (required
# because each deployment creates its own resource group, a subscription-level
# action):
#   * Contributor                         - create/manage/delete resources + RGs
#   * Role Based Access Control Administrator (constrained, condition v2.0)
#                                         - create the RBAC role assignments the
#                                           keyless/passwordless templates need,
#                                           while the built-in condition BLOCKS
#                                           assigning privileged roles (Owner,
#                                           Contributor, UAA, RBAC Admin) so the
#                                           deployer cannot escalate privilege.
#
# Templates: the backend submits precompiled ARM JSON, not Bicep. Run
#   ./tools/Build-Templates.ps1
# to generate site/server/_templates/<use_case>/<env>.json (CI does this
# automatically before publishing — see deploy-gallery.yml).

# Subscription deployments target (resource groups are created per deployment).
GALLERY_SUBSCRIPTION_ID=8ad2703f-069c-4c1a-8f4f-850c2a4c2676

# Azure region for the per-deployment resource groups.
GALLERY_DEPLOY_LOCATION=eastus

# --------------------------------------------------------------------------- #
# Use-case submissions (zip upload -> review branch)
# --------------------------------------------------------------------------- #
# When a user uploads a template zip, the backend validates + stages it and then
# creates a review BRANCH with the bundle committed, so a maintainer only has to
# open the pre-filled pull request (org policy blocks automation from opening PRs
# directly). Without a token the upload still works but stays staged for manual
# download from the admin panel.
#
# Token: a fine-grained PAT (or GitHub App installation token) scoped to the repo
# below with "Contents: Read and write". Store it as an App Service application
# setting, NOT in source. Leave empty to disable branch creation.
GALLERY_GITHUB_TOKEN=
# owner/repo that branches are created in (defaults to the gallery repo).
GALLERY_GITHUB_REPO=mcaps-microsoft/TechLabs
# Base branch the review branch is cut from (defaults to main).
GALLERY_GITHUB_BASE=main

# --------------------------------------------------------------------------- #
# Optional: manual "deploy in GitHub" button (deploy-usecase.yml)
# --------------------------------------------------------------------------- #
# The website does NOT use these — they're only for the manual workflow run from
# the GitHub Actions tab. Configure them as REPO SECRETS (not app settings):
#   AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_SUBSCRIPTION_ID
# on an app registration / user-assigned identity with a federated credential
# trusting this repo. No PAT, no client secret (OIDC).

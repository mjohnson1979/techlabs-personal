# Python virtual environment & caches
server/.venv/
**/__pycache__/
*.pyc

# Local environment configuration (never commit secrets/tenant config)
server/.env

# Generated SQLite database (control plane system of record)
server/data/

# Customer-supplied compiled ARM templates, never bundled as platform source
server/_templates/

# Staged Terraform modules + per-deployment working dirs (generated)
server/_tf/
server/_tf_runs/
server/platform-source.json

# OS / editor cruft
.DS_Store
Thumbs.db
